{
  "name": "fileship-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "locales": "node ../scripts/build-locales.mjs",
    "build": "npm run locales && vite build",
    "build:embedded": "npm run build && node ../scripts/sync-frontend.mjs",
    "preview": "vite preview",
    "check": "svelte-check",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  }
}
