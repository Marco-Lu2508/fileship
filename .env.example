PORT=8080

# Recommended for stable sessions across restarts. Generate with: openssl rand -hex 32
JWT_SECRET=

# Set a strong initial admin password, or leave empty to generate one in the logs
ADMIN_PASSWORD=

DB_PATH=./fileship.db
ROOT_PATH=./data
MAX_UPLOAD_MB=1024

# Optional TLS
# TLS_CERT=./cert.pem
# TLS_KEY=./key.pem

# Optional: restrict upload types (comma-separated MIME prefixes)
# ALLOWED_TYPES=image/,application/pdf,text/
