# Fileship (Rust) — environment variables
# PORT=8080
# ROOT_PATH=/data
# DB_PATH=/data/fileship.db
# JWT_SECRET=change-me-to-a-long-random-secret
# ADMIN_PASSWORD=admin-start-password
# MAX_UPLOAD_MB=1024
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem
# AUDIT_RETENTION_DAYS=90
# TRASH_RETENTION_DAYS=30

# SSO (OIDC) — leave unset to disable
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=fileship
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://fileship.example.com/api/auth/oidc/callback
# OIDC_AUTO_REGISTER=1
# OIDC_ADMIN_EMAILS=admin@example.com
