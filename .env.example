PORT=8080

# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED: Set a strong password
ADMIN_PASSWORD=

DB_PATH=./fileship.db
ROOT_PATH=./data
MAX_UPLOAD_MB=1024

# Optional TLS
# TLS_CERT=./cert.pem
# TLS_KEY=./key.pem

# Optional: restrict upload types (comma-separated MIME prefixes)
# ALLOWED_TYPES=image/,application/pdf,text/
